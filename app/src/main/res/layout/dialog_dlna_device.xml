<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="@dimen/vs_440"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_dialog_bg_main">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/vs_20"
            android:singleLine="true"
            android:text="选择投屏设备"
            android:textColor="@color/color_CC000000"
            android:textSize="@dimen/ts_26"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/vs_15"
            android:text="刷新"
            android:textColor="@color/color_CC000000"
            android:textSize="@dimen/ts_22"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/empty_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/vs_40"
            android:text="正在搜索设备..."
            android:textColor="@color/color_CC000000"
            android:textSize="@dimen/ts_24"
            android:visibility="visible"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/device_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="@dimen/vs_30"
            android:paddingRight="@dimen/vs_30"
            app:layout_constrainedHeight="true"
            app:layout_constraintHeight_max="@dimen/vs_480"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title" />

        <!-- Barrier sits below whichever of empty_tip / device_list is taller -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="empty_tip,device_list" />

        <TextView
            android:id="@+id/debug_log_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="@dimen/vs_30"
            android:paddingRight="@dimen/vs_30"
            android:paddingTop="@dimen/vs_10"
            android:text="调试日志："
            android:textColor="@color/color_CC000000"
            android:textSize="@dimen/ts_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/barrier_content" />

        <ScrollView
            android:id="@+id/debug_scroll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_100"
            android:paddingLeft="@dimen/vs_30"
            android:paddingRight="@dimen/vs_30"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/debug_log_label">

            <TextView
                android:id="@+id/tv_debug_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/color_CC000000"
                android:textSize="@dimen/ts_16" />
        </ScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/vs_20"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/debug_scroll" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
